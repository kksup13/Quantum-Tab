{
  "manifest_version": 3,
  "name": "Quantum Tab",
  "version": "1.0",
  "description": "Create the browser homepage of your dreams.",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ]
}